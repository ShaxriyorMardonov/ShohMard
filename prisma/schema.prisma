generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STUDENT
}

enum StudyForm {
  KUNDUZGI
  SIRTQI
  KECHKI
  MASOFAVIY
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
}

enum ResultRelease {
  IMMEDIATE
  AFTER_END
  MANUAL
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model University {
  id        String   @id @default(cuid())
  name      String   @unique
  shortName String
  city      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  User[]
  faculties Faculty[]
  groups    Group[]
  tests     Test[]    @relation("TestUniversities")
}

model Faculty {
  id           String     @id @default(cuid())
  name         String
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  groups   Group[]
  students User[]

  @@unique([universityId, name])
}

model Group {
  id           String     @id @default(cuid())
  name         String
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  facultyId    String?
  faculty      Faculty?   @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  students User[]

  @@unique([universityId, name])
  @@index([facultyId])
}

model User {
  id             String    @id @default(cuid())
  login          String    @unique
  passwordHash   String
  fullName       String
  role           Role      @default(STUDENT)
  /// Foydalanuvchining barcha rollari (role — asosiy rol, kirganda shu ochiladi)
  roles          Role[]    @default([STUDENT])
  isActive       Boolean   @default(true)
  /// JShShIR (shaxsiy identifikatsiya raqami, 14 ta raqam) — talabalar takrorlanmasligi uchun
  pinfl          String?   @unique
  /// Birinchi kirishda (yoki parol tiklangach) yangi parol qo'yish majburiy
  mustChangePassword Boolean @default(false)
  studyForm      StudyForm?
  universityId   String?
  university     University? @relation(fields: [universityId], references: [id], onDelete: Restrict)
  facultyId      String?
  faculty        Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  groupId        String?
  group          Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  /// Ikki bosqichli tasdiq kodi yuboriladigan email (Gmail). Super admin uchun.
  email          String?   @unique
  emailVerifiedAt DateTime?
  passwordChangedAt DateTime?
  /// Shaxsiy tasodifiy boshlang'ich parol qachon berilgan (null + mustChangePassword — eski umumiy parol)
  initialPasswordAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions  Session[]
  attempts  Attempt[]
  testsMade Test[]     @relation("TestAuthor")
  testAccess TestAccess[]
  emailCodes EmailCode[]

  @@index([universityId])
  @@index([facultyId])
  @@index([groupId])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// Bir nechta roli bo'lgan foydalanuvchining hozir tanlagan roli
  activeRole Role?
  /// Parol to'g'ri, lekin ikki bosqichli tasdiq hali o'tilmagan
  mfaPending Boolean  @default(false)
  ip         String?
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
}

model Test {
  id              String        @id @default(cuid())
  title           String
  description     String?
  subject         String?
  durationMinutes Int
  startsAt        DateTime
  endsAt          DateTime
  isPublished     Boolean       @default(false)
  passingPercent  Int           @default(60)
  resultRelease   ResultRelease @default(IMMEDIATE)
  /// Har bir talabaga tasodifiy tanlanadigan savollar soni (null — hammasi)
  questionsPerAttempt Int?
  /// Testning jami (maksimal) bahosi (null — savollar ballari yig'indisi)
  maxScore        Int?
  /// Talaba testni necha marta topshira oladi
  maxAttempts     Int           @default(1)
  resultsReleasedAt DateTime?
  restrictedAccess  Boolean       @default(false)
  createdById     String?
  createdBy       User?         @relation("TestAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  universities University[]   @relation("TestUniversities")
  questions    TestQuestion[]
  attempts     Attempt[]
  access       TestAccess[]

  @@index([startsAt, endsAt])
  @@index([subject])
}

/// Test "faqat ruxsat berilgan talabalar" rejimida bo'lsa, kim topshira olishi.
model TestAccess {
  testId    String
  userId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([testId, userId])
  @@index([userId])
}

model Question {
  id          String       @id @default(cuid())
  text        String
  type        QuestionType
  subject     String?
  explanation String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  options QuestionOption[]
  tests   TestQuestion[]
  answers Answer[]

  @@index([subject])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  position   Int

  @@index([questionId])
}

model TestQuestion {
  testId     String
  questionId String
  position   Int
  points     Int      @default(1)
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([testId, questionId])
  @@index([testId, position])
}

model Attempt {
  id            String        @id @default(cuid())
  testId        String
  test          Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  deadlineAt    DateTime
  submittedAt   DateTime?
  autoSubmitted Boolean       @default(false)
  /// Shu talabaga tushgan savollar (bo'sh — testning barcha savollari)
  questionIds   String[]      @default([])
  score         Float?
  maxScore      Float?
  percent       Float?
  correctCount  Int?
  totalQuestions Int?
  /// Talabaning shu testdagi nechanchi urinishi (1 dan)
  attemptNo     Int           @default(1)
  /// Imtihon nazorati: test qaysi sessiyada (qurilmada) ochilgani va shubhali harakatlar soni
  sessionId     String?
  tabSwitches   Int           @default(0)
  copyEvents    Int           @default(0)
  deviceChanges Int           @default(0)

  answers Answer[]

  @@unique([testId, userId, attemptNo])
  @@index([testId, userId])
  @@index([userId])
  @@index([status, deadlineAt])
}

model Answer {
  id                String   @id @default(cuid())
  attemptId         String
  attempt           Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOptionIds String[]
  flagged           Boolean  @default(false)
  isCorrect         Boolean?
  pointsAwarded     Int?
  updatedAt         DateTime @updatedAt

  @@unique([attemptId, questionId])
}

/// Kirish urinishlari: IP va login bo'yicha cheklov uchun
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  login     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([login, createdAt])
}

/// Harakatlar jurnali: kim, qachon, qaysi IP'dan nima qildi. O'chirilmaydi.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  userLogin String?
  action    String
  target    String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([userId, createdAt])
}

/// Emailga yuborilgan bir martalik kodlar: kirishni tasdiqlash va email manzilini tasdiqlash
model EmailCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "login" yoki "verify_email"
  purpose   String
  email     String
  codeHash  String
  /// Kirish kodi qaysi (tasdiqlanmagan) sessiyaga tegishli
  sessionId String?
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
}
